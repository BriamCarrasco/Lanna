# Normalizar finales de línea: LF en el repo, checkout nativo por OS.
* text=auto eol=lf

# Scripts/archivos específicos de Windows
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binarios
*.png  binary
*.ico  binary
*.jpg  binary
*.jar  binary
*.ttf  binary
*.otf  binary
*.keystore binary
